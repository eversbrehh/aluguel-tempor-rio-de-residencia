NODE_ENV=development

# Supabase (mesmo projeto do monolito)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY

# RabbitMQ
RABBITMQ_URL=amqp://lamd:lamd123@localhost:5672
