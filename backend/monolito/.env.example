# Servidor
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Supabase
# Pegue em: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# CORS (lista separada por vírgula; use * em dev)
CORS_ORIGIN=*

# RabbitMQ (Sprint 2)
RABBITMQ_URL=amqp://lamd:lamd123@localhost:5672
RABBITMQ_EXCHANGE=lamd.events
RABBITMQ_DLX=lamd.events.dlx
RABBITMQ_DLQ=lamd.events.dlq

# Outbox Worker (Sprint 2)
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5

# Identificador do produtor no envelope do evento
EVENT_SOURCE=monolito
